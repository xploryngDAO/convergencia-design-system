    },
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": [
    "dist",
    "tokens/tokens.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && tsc -p tsconfig.build.json && vite build && node scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
