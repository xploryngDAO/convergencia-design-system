    "http-server": "^14.1.1",
    "postcss": "^8.5.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
