    "prepack": "npm run build",
    "audit:source": "node scripts/audit-source.mjs",
    "adopt": "node scripts/adopt.mjs",
    "verify:blocks": "node scripts/verify-blocks.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
